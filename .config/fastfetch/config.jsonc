// rainyx fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "sixel",
    "color": {"1": "#cba6f7", "2": "#89b4fa"},
    "source": "~/.config/fastfetch/images/blue_void.png",
    // "source": "~/.config/fastfetch/ascii/void.txt",
    "padding": {
      "top": 1,
      "right": 3
    },
    "height": 15
  },
  "display": {
    "separator": " ▸▸ ",
    "color": {
      "keys": "#89b4fa",
      "title": "#cba6f7",
      "separator": "#6c7086",
      "output": "#cdd6f4"
    },
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": { "user": "#cba6f7", "at": "#6c7086", "host": "#89b4fa" }
    },
    {
      "type": "separator",
      "outputColor": "#6c7086"
    },
    { "type": "os", "keyColor": "#89b4fa" },
    { "type": "host", "keyColor": "#89b4fa" },
    { "type": "kernel", "keyColor": "#89b4fa" },
    { "type": "uptime", "keyColor": "#89b4fa" },
    { "type": "packages", "keyColor": "#a6e3a1" },
    { "type": "shell", "keyColor": "#a6e3a1" },
    { "type": "de", "keyColor": "#a6e3a1" },
    { "type": "wm", "keyColor": "#a6e3a1" },
    { "type": "terminal", "keyColor": "#a6e3a1" },
    { "type": "cpu", "keyColor": "#fab387" },
    { "type": "gpu", "keyColor": "#fab387" },
    { "type": "memory", "keyColor": "#fab387" },
    { "type": "disk", "keyColor": "#fab387" },
    "break",
    {
      "type": "colors",
      "paddingLeft": 5,
      "symbol": "circle",
      "block": {
        "width": 10
      }
    },
  ],
}
