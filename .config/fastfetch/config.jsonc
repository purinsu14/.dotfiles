// rainyx fastfetch (pc)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii/rose.txt",
    "color": { "1": "#e03a58" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": " ▸▸ ",
    "color": {
      "keys": "#ff4d6d",
      "title": "#ff4d6d",
      "separator": "#888888",
      "output": "#c9a9b0"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": { "user": "#ff4d6d", "at": "#888888", "host": "#ff8fa3" }
    },
    { "type": "separator", "outputColor": "#888888" },

    // system
    { "type": "os", "keyColor": "#ff8fa3" },
    { "type": "host", "keyColor": "#ff8fa3" },
    { "type": "board", "keyColor": "#ff8fa3" },
    { "type": "kernel", "keyColor": "#ff8fa3" },
    { "type": "initsystem", "keyColor": "#ff8fa3" },
    { "type": "uptime", "keyColor": "#ff8fa3" },

    // software
    { "type": "packages", "keyColor": "#ff4d6d" },
    { "type": "shell", "keyColor": "#ff4d6d" },
    { "type": "terminal", "keyColor": "#ff4d6d" },
    { "type": "terminalfont", "keyColor": "#ff4d6d" },
    { "type": "wm", "keyColor": "#ff4d6d" },

    // hardware
    { "type": "cpu", "keyColor": "#e03a58" },
    { "type": "gpu", "keyColor": "#e03a58" },
    { "type": "memory", "keyColor": "#e03a58" },
    { "type": "swap", "keyColor": "#e03a58" },
    { "type": "display", "keyColor": "#e03a58" },
    { "type": "disk", "keyColor": "#e03a58" },
    "break",
    {
      "type": "colors",
      "paddingLeft": 5,
      "symbol": "circle",
      "block": {
        "width": 10
      }
    },
  ]
}
