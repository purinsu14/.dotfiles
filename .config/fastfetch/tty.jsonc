{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii/rose.txt",
    "color": { "1": "91" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": " ▸ ",
    "color": {
      "keys": "91",
      "title": "91",
      "separator": "90",
      "output": "90"
    }
  },
  "modules": [
    "break",
    { "type": "title", "color": { "user": "92", "at": "90", "host": "91" } },
    { "type": "separator", "outputColor": "90" },
    { "type": "os",       "keyColor": "92" },
    { "type": "kernel",   "keyColor": "91" },
    { "type": "uptime",   "keyColor": "93" },
    { "type": "packages", "keyColor": "94" },
    { "type": "shell",    "keyColor": "94" },
    { "type": "cpu",      "keyColor": "95" },
    { "type": "memory",   "keyColor": "95" },
    { "type": "disk",     "keyColor": "95" }
  ]
}
