# RAINYX TOFI
# set size
width = 800
height = 340
anchor = center
horizontal = false

# set font and prompt
font = Lilex Nerd Font Mono Medium
font-size = 14
prompt-text = "Run: "
num-results = 10
result-spacing = 3

# ~80% opaque (cc)
background-color = #160a0dcc
text-color = #e8d5d9
prompt-color = #e03a58
selection-color = #ff8fa3
selection-background = #4a1c27
selection-background-padding = 4
selection-background-corner-radius = 0

# thin muted border
outline-width = 0
border-width = 2
border-color = #5a242e
corner-radius = 14

padding-top = 8
padding-bottom = 8
padding-left = 12
padding-right = 12
