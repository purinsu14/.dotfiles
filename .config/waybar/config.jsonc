{ // waybar config (desktop)
	"layer": "top",
	"position": "top",

	"modules-left": [
		"custom/separator#dot-line",
		"group/mobo_drawer",
		"custom/separator#dot-line",
		"custom/update",
		"custom/separator#dot-line",
		"custom/weather",
	],
	"modules-center": [
		"custom/separator#dot-line",
		"group/clock-group",
		"custom/separator#dot-line",
		"idle_inhibitor",
	],
	"modules-right": [
		"group/mpris-group",
		"custom/separator#dot-line",
		"group/audio",
		"custom/separator#dot-line",
		"group/backlight-group",
		"custom/separator#dot-line",
		"group/network-group",
		"custom/separator#dot-line",
		"group/tray-group",
	],

	// NOTE : Hardware (left drawer)
	"cpu": {
		"interval": 2,
		"format": "󰻠 {usage:>2}%",
		"on-click-right": "foot -e btop",
	},
	"cpu#freq": {
		"interval": 2,
		"format": "󰓅 {avg_frequency:.1f}GHz",
		"on-click-right": "foot -e btop",
	},
	"temperature": {
		"interval": 10,
		"tooltip": true,
		// hwmon3 = k10temp (AMD CPU) on this machine. hwmon numbers can shift between boots.
		// grep . /sys/class/hwmon/hwmon*/name
		"hwmon-path": [
			"/sys/class/hwmon/hwmon3/temp1_input",
		],
		"critical-threshold": 82,
		"format": "󰔏 {temperatureC}°C",
		"format-critical": "󰸁 {temperatureC}°C",
	},
	"custom/gpu": {
		"exec": "~/.config/waybar/scripts/gpu.sh",
		"return-type": "json",
		"interval": 3,
		"format": "󰢮 {}",
		"on-click-right": "foot -e nvtop",
	},
	"memory": {
		"interval": 5,
		"states": { "warning": 75, "critical": 90 },
		"format": "󰍛 {percentage}%",
		"format-critical": "󰀦 {percentage}%",
		"tooltip-format": "Memory Used: {used:0.1f} GB / {total:0.1f} GB",
	},
	"disk": {
		"interval": 60,
		"path": "/",
		"format": "󰋊 {percentage_used}%",
		"tooltip-format": "{used} / {total} used on {path}",
	},

	// NOTE : Clock
	"clock#time": {
		"format": "󰥔 {:%H:%M:%S}",
		"format-alt": "󰃭 {:%a, %d %b}",
		"interval": 1,
		"tooltip-format": "<tt>{calendar}</tt>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"format": {
				"months": "<span color='#ff8fa3'><b>{}</b></span>",
				"weekdays": "<span color='#e03a58'><b>{}</b></span>",
				"today": "<span color='#ff4d6d'><b>{}</b></span>",
			},
		},
		"actions": { "on-click-right": "mode" },
	},
	"clock#date": {
		"format": "󰃭 {:%A, %d %B}",
		"interval": 60,
		"tooltip-format": "<tt>{calendar}</tt>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"format": {
				"months": "<span color='#ff8fa3'><b>{}</b></span>",
				"weekdays": "<span color='#e03a58'><b>{}</b></span>",
				"today": "<span color='#ff4d6d'><b>{}</b></span>",
			},
		},
		"actions": { "on-click-right": "mode" },
	},

	// NOTE : Brightness (DDC via ddcutil, see scripts/brightness.sh)
	"custom/brightness#icon": {
		"exec": "~/.config/waybar/scripts/brightness.sh",
		"return-type": "json",
		"interval": "once",
		"signal": 8,
		"format": "{icon}",
		"format-icons": ["󰃞", "󰃟", "󰃠"],
		"on-scroll-up": "~/.config/waybar/scripts/brightness.sh up >/dev/null; pkill -RTMIN+8 waybar",
		"on-scroll-down": "~/.config/waybar/scripts/brightness.sh down >/dev/null; pkill -RTMIN+8 waybar",
		"tooltip": true,
	},
	"custom/brightness#text": {
		"exec": "~/.config/waybar/scripts/brightness.sh",
		"return-type": "json",
		"interval": "once",
		"signal": 8,
		"format": "{text}",
		"on-scroll-up": "~/.config/waybar/scripts/brightness.sh up >/dev/null; pkill -RTMIN+8 waybar",
		"on-scroll-down": "~/.config/waybar/scripts/brightness.sh down >/dev/null; pkill -RTMIN+8 waybar",
		"tooltip": false,
	},

	// NOTE : Network (icon + text, same drawer style as the rest)
	"network#icon": {
		"format-wifi": "{icon}",
		"format-ethernet": "󰈀",
		"format-disconnected": "󰖪",
		"format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
		"tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
		"tooltip-format-ethernet": "{ifname}\n{ipaddr}",
		"tooltip-format-disconnected": "Disconnected",
		"on-click": "foot -e nmtui",
	},
	"network#text": {
		"interval": 2,
		"format-wifi": "{essid}  {bandwidthDownBytes}",
		"format-ethernet": "{bandwidthDownBytes}  {bandwidthUpBytes}",
		"format-disconnected": "offline",
		"tooltip": false,
		"on-click": "foot -e nmtui",
	},

	// NOTE : Audio
	"pulseaudio#icon": {
		"format": "{icon}",
		"format-muted": "󰝟",
		"format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
		"on-click-middle": "pavucontrol",
		"on-click": "swayosd-client --output-volume mute-toggle",
		"on-scroll-up": "swayosd-client --output-volume +1",
		"on-scroll-down": "swayosd-client --output-volume -1",
		"tooltip": true,
		"tooltip-format": "{desc} | {volume}%",
	},
	"pulseaudio#text": {
		"format": "{volume}%",
		"format-muted": "muted",
		"on-click-middle": "pavucontrol",
		"on-click": "swayosd-client --output-volume mute-toggle",
		"on-scroll-up": "swayosd-client --output-volume +1",
		"on-scroll-down": "swayosd-client --output-volume -1",
		"tooltip": false,
	},
	"pulseaudio#microphone": {
		"format": "{format_source} {source_volume}%",
		"format-source": "󰍬",
		"format-source-muted": "󰍭",
		"on-click": "swayosd-client --input-volume mute-toggle",
		"on-click-middle": "",
		"on-scroll-up": "swayosd-client --input-volume +1",
		"on-scroll-down": "swayosd-client --input-volume -1",
		"tooltip-format": "{source_desc} | {source_volume}%",
	},

	// NOTE : Media
	"mpris": {
		"format": "{player_icon}",
		"format-paused": "󰏤 {player_icon}",
		"on-click-middle": "",
		"on-click-right": "",
		"player-icons": {
			"default": "󰎆",
			"spotify": "󰓇",
			"firefox": "󰈹",
			"chromium": "󰊯",
		},
	},
	"mpris#title": {
		"format": "{title}",
		"format-paused": "{title}",
		"artist-len": 10,
		"title-len": 20,
		"on-click-middle": "",
		"on-click-right": "",
	},

	// NOTE : Tray (plain group so it gets the same pill as the others)
	"tray": {
		"icon-size": 16,
		"spacing": 10,
	},

	// NOTE : Misc
	"custom/weather": {
		"exec": "python3 ~/.config/waybar/scripts/weather.py",
		"restart-interval": 300,
		"return-type": "json",
	},
	"custom/update": {
		"exec": "~/.config/waybar/scripts/system-update.sh",
		"return-type": "json",
		"format": "{}",
		"on-click": "~/.config/waybar/scripts/system-update.sh up",
		"interval": 30,
		"min-length": 3,
	},
	"custom/separator#dot-line": {
		"format": "",
		"interval": "once",
		"tooltip": false,
	},
	"idle_inhibitor": {
		"tooltip": true,
		"tooltip-format-activated": "Idle inhibitor: on",
		"tooltip-format-deactivated": "Idle inhibitor: off",
		"format": "{icon}",
		"format-icons": { "activated": "󰈈", "deactivated": "󰈉" },
	},

	// NOTE : Groups (all drawers behave the same way)
	"group/mobo_drawer": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 500,
			"children-class": "mobo-child",
			"transition-left-to-right": true,
		},
		"modules": ["cpu", "cpu#freq", "temperature", "custom/gpu", "memory", "disk"],
	},
	"group/clock-group": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 500,
			"children-class": "clock-child",
			"transition-left-to-right": true,
		},
		"modules": ["clock#time", "clock#date"],
	},
	"group/mpris-group": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 500,
			"children-class": "mpris-child",
			"transition-left-to-right": true,
		},
		"modules": ["mpris", "mpris#title"],
	},
	"group/audio": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 500,
			"children-class": "audio-child",
			"transition-left-to-right": true,
		},
		"modules": ["pulseaudio#icon", "pulseaudio#text", "pulseaudio#microphone"],
	},
	"group/backlight-group": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 500,
			"children-class": "backlight-child",
			"transition-left-to-right": true,
		},
		"modules": ["custom/brightness#icon", "custom/brightness#text"],
	},
	"group/network-group": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 500,
			"children-class": "network-child",
			"transition-left-to-right": true,
		},
		"modules": ["network#icon", "network#text"],
	},
	"group/tray-group": {
		"orientation": "inherit",
		"modules": ["tray"],
	},
}
