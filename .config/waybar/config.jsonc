{ // waybar config
	"layer": "top",
	"position": "top",
	"modules-left": [
		"custom/separator#dot-line",
		"group/mobo_drawer",
		"custom/separator#dot-line",
		"custom/update",
		"custom/separator#dot-line",
		"custom/weather",
	],
	"modules-center": [
		"custom/separator#dot-line",
		"group/clock-group",
		"custom/separator#dot-line",
		"group/util-toggle-group",
	],
	"modules-right": [
		"group/mpris-group",
		"custom/separator#dot-line",
		"group/audio",
		"custom/separator#dot-line",
		"group/backlight-group",
		"custom/separator#dot-line",
		"group/battery-group",
		"custom/separator#dot-line",
		"tray",
	],
	"tray": {
		"icon-size": 16,
		"spacing": 10,
	},
	"clock#time": {
		"format": "  {:%H:%M:%S}",
		"format-alt": "  {:%a, %d %b}",
		"interval": 1,
		"tooltip-format": "<tt>{calendar}</tt>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"format": {
				"months": "<span color='#f5e0dc'><b>{}</b></span>",
				"weekdays": "<span color='#f9e2af'><b>{}</b></span>",
				"today": "<span color='#f38ba8'><b>{}</b></span>",
			},
		},
		"actions": { "on-click-right": "mode" },
		"min-length": 8,
		"max-length": 28,
	},
	"clock#date": {
		"format": "   {:%A, %d %B}",
		"interval": 1,
		"tooltip-format": "<tt>{calendar}</tt>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"format": {
				"months": "<span color='#f5e0dc'><b>{}</b></span>",
				"weekdays": "<span color='#f9e2af'><b>{}</b></span>",
				"today": "<span color='#f38ba8'><b>{}</b></span>",
			},
		},
		"actions": { "on-click-right": "mode" },
		"min-length": 8,
		"max-length": 28,
	},
	"temperature": {
		"interval": 10,
		"tooltip": true,
		"hwmon-path": [
			"/sys/class/hwmon/hwmon1/temp1_input",
			"/sys/class/thermal/thermal_zone0/temp",
		],
		"critical-threshold": 82,
		"format-critical": "{temperatureC}°C {icon}",
		"format": "{icon} {temperatureC}°C",
		"format-icons": ["󰈸"],
		"on-click-right": "foot -e nvtop",
	},
	"cpu": {
		"interval": 1,
		"format": "{icon0}{icon1}{icon2}{icon3} {usage:>2}% ",
		"format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
	},
	"memory": {
		"states": {
			"warning": 75,
			"critical": 90,
		},
		"format": "  {percentage}%",
		"format-critical": "󰀦 {percentage}%",
		"tooltip-format": "Memory Used: {used:0.1f} GB / {total:0.1f} GB",
		"interval": 5,
	},
	"backlight#icon": {
		"format": "{icon}",
		"format-icons": ["", "", "", "", "", "", "", "", ""],
		"tooltip": true,
		"tooltip-format": "{percent}%",
		"on-scroll-up": "swayosd-client --brightness +5",
		"on-scroll-down": "swayosd-client --brightness -5",
	},
	"backlight#text": {
		"format": "{percent}%",
		"tooltip": true,
		"tooltip-format": "{percent}%",
		"on-scroll-up": "swayosd-client --brightness +5",
		"on-scroll-down": "swayosd-client --brightness -5",
	},
	"network": {
		"format-wifi": "{icon}",
		"format-disconnected": "\uf127",
		"tooltip-format": "{essid}",
		"on-click": "~/.config/waybar/scripts/network/rofi-network-manager.sh",
		"format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
	},
	"pulseaudio#icon": {
		"format": "{icon}",
		"format-muted": "\uDB81\uDF5F",
		"format-icons": {
			"default": ["", "", "󰕾"],
		},
		"on-click-middle": "pavucontrol",
		"on-click": "swayosd-client --output-volume mute-toggle",
		"on-scroll-up": "swayosd-client --output-volume +1",
		"on-scroll-down": "swayosd-client --output-volume -1",
		"tooltip": true,
		"tooltip-format": "{sink_desk} | {volume}%",
	},
	"pulseaudio#text": {
		"format": "{volume}%",
		"format-muted": "muted",
		"on-click-middle": "pavucontrol",
		"on-click": "swayosd-client --output-volume mute-toggle",
		"on-scroll-up": "swayosd-client --output-volume +1",
		"on-scroll-down": "swayosd-client --output-volume -1",
		"tooltip": false,
	},
	"pulseaudio#microphone": {
		"format": "{format_source} {source_volume}%",
		"format-source": "",
		"format-source-muted": "󰍭",
		"on-click": "swayosd-client --input-volume mute-toggle",
		"on-click-middle": "",
		"on-scroll-up": "swayosd-client --input-volume +1",
		"on-scroll-down": "swayosd-client --input-volume -1",
		"tooltip-format": "{source_desc} | {source_volume}%",
	},
	"battery#icon": {
		"bat": "BAT0",
		"adapter": "ACAD",
		"interval": 60,
		"states": {
			"warning": 30,
			"critical": 15,
		},
		"max-length": 20,
		"format": "{icon} ",
		"format-warning": "{icon} ",
		"format-critical": "{icon} ",
		"format-charging": "\uDB80\uDC84",
		"format-plugged": "\uDB81\uDEA5",
		"tooltip": true,
		"tooltip-format": "{capacity}%",
		"format-alt": "{icon} {time}",
		"format-full": "\uDB81\uDEA5",
		"format-icons": ["", "", "", "", ""],
	},
	"battery#text": {
		"bat": "BAT0",
		"adapter": "ACAD",
		"interval": 60,
		"states": {
			"warning": 30,
			"critical": 15,
		},
		"max-length": 20,
		"format": "{capacity}%",
		"format-warning": "{capacity}%",
		"format-critical": "{capacity}%",
		"format-charging": "{capacity}%",
		"format-plugged": "Plugged",
		"tooltip": true,
		"tooltip-format": "{capacity}%",
		"format-full": "Full",
		"format-icons": ["", "", "", "", ""],
	},
	"custom/weather": {
		"exec": "python3 ~/.config/waybar/scripts/weather.py",
		"restart-interval": 300,
		"return-type": "json",
	},
	"mpris#title": {
		"format": "{title} ",
		"format-paused": " {title} ",
		"artist-len": 10,
		"title-len": 20,
		"on-click-middle": "",
		"on-click-right": "",
	},
	"mpris": {
		"format": "{player_icon}",
		"format-paused": " | {player_icon}",
		"artist-len": 10,
		"title-len": 20,
		"on-click-middle": "",
		"on-click-right": "",
		"player-icons": {
			"default": " ",
			"mpv": "🎵",
			"spotify": " ",
			"firefox": " ",
			"chromium": " ",
		},
	},
	// NOTE : Custom Modules
	"custom/separator#dot-line": {
		"format": "",
		"interval": "once",
		"tooltip": false,
	},
	"idle_inhibitor": {
		"tooltip": true,
		"tooltip-format-activated": "Idle_inhibitor active",
		"tooltip-format-deactivated": "Idle_inhibitor not active",
		"format": "{icon}",
		"format-icons": {
			"activated": " ",
			"deactivated": " ",
		},
	},
	"custom/update": {
		"exec": "~/.config/waybar/scripts/system-update.sh",
		"return-type": "json",
		"format": "{}",
		"on-click": "~/.config/waybar/scripts/system-update.sh up",
		"interval": 30,
		"min-length": 3,
	},
	// NOTE : Groups from here
	"group/audio": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 500,
			"children-class": "audio-child",
			"transition-left-to-right": true,
		},
		"modules": ["pulseaudio#icon", "pulseaudio#text", "pulseaudio#microphone"],
	},
	"group/mpris-group": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 500,
			"children-class": "mpris-child",
			"transition-left-to-right": true,
		},
		"modules": ["mpris", "mpris#title"],
	},
	"group/mobo_drawer": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 500,
			"children-class": "mobo-child",
			"transition-left-to-right": true,
		},
		"modules": ["cpu", "temperature", "memory"],
	},
	"group/backlight-group": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 500,
			"children-class": "backlight-child",
			"transition-left-to-right": true,
		},
		"modules": ["backlight#icon", "backlight#text"],
	},
	"group/battery-group": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 500,
			"children-class": "battery-child",
			"transition-left-to-right": true,
		},
		"modules": ["battery#icon", "battery#text"],
	},
	"group/clock-group": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 500,
			"children-class": "clock-child",
			"transition-left-to-right": true,
		},
		"modules": ["clock#time", "clock#date"],
	},
	"group/util-toggle-group": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 500,
			"children-class": "util-child",
			"transition-left-to-right": true,
		},
		"modules": ["idle_inhibitor", "power-profiles-daemon"],
	},
}
